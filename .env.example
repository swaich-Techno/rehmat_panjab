# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — leave empty until the project is linked.
# Never put the service role key in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin preview gate. If unset, /admin stays locked and shows setup instructions.
ADMIN_PREVIEW_KEY=

# HMAC signing for next-drop thank-you rewards and checkout request tokens.
# Required in production (the app fails closed if unset). Local fallback only in development.
REWARD_SIGNING_SECRET=

# Optional WhatsApp number for manual order requests (E.164, no +). Example: 9198XXXXXXXX
WHATSAPP_ORDER_NUMBER=

# Razorpay — architecture is prepared; keys are not required to run the site.
# Do not enable live charges until checkout is intentionally launched.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
